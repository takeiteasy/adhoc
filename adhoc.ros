#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn (ros:ensure-asdf)
  #+quicklisp (unless (or (member :swank *features*) (member :slynk *features*))
                (setf ql:*quickload-verbose* nil)))

(ros:quicklisp)

(defun main (&rest argv)
  (declare (ignorable argv))
  (ql:quickload :adhoc :silent t)
  (funcall (intern "MAIN" "ADHOC/CLI") argv))

-- tensors.ad — vectors, matrices, and higher-rank tensors
-- run with: adhoc run demos/tensors.ad

-- `,` separates columns, `;` rows; indexing is 1-based
v = [1, 2, 3]
m = [1, 2; 3, 4]
v[2]
m[2, 1]
m[1]

-- + - * / ^ are elementwise; a scalar broadcasts
m + 1
2m
m * m
m ^ 2

-- · (or \cdot) contracts: dot product, matrix product, matrix-vector
[1, 2] · [3, 4]
m · m
m \cdot [1, 1]

-- ' transposes; a trailing `;` makes a one-row matrix
m'
[1; 2]'

-- rank 3 and up nest
[[1, 2; 3, 4], [5, 6; 7, 8]]

-- entries stay exact
[√2, 1/3] * 3

-- folds run over the outer slices
\sum(x=v) x^2
\sum(r=m) r

\shape(m)
\len(v)

-- tensors.ad — vectors, matrices, and higher-order tensors
-- run with: adhoc run demos/tensors.ad

-- `,` separates columns, `;` rows; indexing is 1-based
v = [1, 2, 3]
m = [1, 2; 3, 4]
v[2]
m[2, 1]
m[1]

-- + - * / ^ are elementwise; a scalar broadcasts
m + 1
2m
m * m
m ^ 2

-- @ (or \contract) contracts: dot product, matrix product, matrix-vector
[1, 2] @ [3, 4]
m @ m
m \contract [1, 1]

-- ' transposes; a trailing `;` makes a one-row matrix
m'
[1; 2]'

-- order 3 and up nest
[[1, 2; 3, 4], [5, 6; 7, 8]]

-- entries stay exact
[√2, 1/3] * 3

-- folds run over the outer slices
\sum(x=v) x^2
\sum(r=m) r

\shape(m)
\len(v)

-- linear algebra is exact over the rationals
a = [2, 1; 1, 3]
\det(a)
\inv(a)
\linsolve(a, [3, 5])
\rank([1, 2; 2, 4])
\rref([1, 2, 3; 4, 5, 6])
\eye(2)
\diag([1, 2])

-- × crosses 3-vectors, ⊗ is the tensor product
[1, 0, 0] × [0, 1, 0]
[1, 2] ⊗ [3, 4]
\kron([1, 2], [3, 4])
\norm([3, 4])
\reshape([1, 2, 3, 4], 2, 2)

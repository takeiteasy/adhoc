-- basics.ad — arithmetic, precedence, assignment
-- run with: adhoc run demos/basics.ad
-- statements in a script file are separated by `;` (whitespace is insignificant)

"a statement that is just a string is ignored -- literate notes like this";

-- precedence works the way the notation reads
1 + 2 * 3;
(1 + 2) * 3;
2^3^2;
-2^2;

-- identifiers are ONE character; juxtaposition is implicit multiplication
α = 7;
β = 3;
αβ;
2α;

-- `=` binds an unbound name, then compares when bound — a bound global
-- can never be reassigned (iteration means a fresh name)
x = 10;
x = 10;
x = 11;

-- the prelude: built-in constants and function builtins, protected everywhere;
-- π and √2 are exact symbolic reals (docs/numerics.md)
π;
\pi;
r = 2;
2 \pi r;
\sqrt(2);
\sin(0);

-- the non-finite floats are nameable prelude constants (IEEE semantics);
-- range bounds must be finite — `a..` is the infinite range form
\inf;
-\inf;
\nan;

-- the ternary `c ? a : b` is the one conditional; a parenthesized group is
-- its multi-line, multi-statement form (newlines separate statements inside
-- parens, and a line ending mid-expression continues onto the next)
r > 0 ? r : -r;
\sum(i=1..10) i > 5 ? i : 0;

-- a binding is immutable: `x = e` binds a fresh name, and repeating it compares
-- (`x = 1` again echoes true) — there is no reassignment spelling at all
-- (a function definition swallows the semicolon-separated statements after it
-- on its own line into its body, so one def per line keeps scripts sane)
φ = 1.6180339887498948;
φ;

-- name aliases: Σ is \sum by seed; \alias declares your own short spelling.
-- \dual defines a name under two spellings at once (the short form reads,
-- and compares as the very same binding)
\alias \prod, ρ;
ρ(j=1..4) j;
\dual \golden, γ = φ;
γ;

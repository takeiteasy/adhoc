-- interop.ad — the \py escape hatch into Python
-- run with: adhoc run demos/interop.ad

-- full trust: any dotted path resolves, arguments convert both ways
\py("math.sqrt")(2);

-- callables bind like any value
s = \py("math.sqrt");
s(16);

-- exact integers survive the round trip
g = \py("math.gcd");
g(1071, 462);

-- fractions.Fraction returns land in the exact rational tier
F = \py("fractions.Fraction");
F(1, 3);
F(1, 3) + F(1, 6);

-- decimals come back exact too
\py("decimal.Decimal")("0.1");

-- strings are full ad values: they bind, concatenate with +, and pass through
-- to Python as native str; every other operator rejects them (typed error)
t = "result" + ":";
t;
l = \py("len");
l(t);
h = "the \"exact\" tier";
h;

-- keyword arguments pass through to Python natively (multi-char names take the \ sigil)
\py("int")("ff", \base=16);
c = \py("math.isclose");
c(1, 1.001, \rel_tol=0.01);
